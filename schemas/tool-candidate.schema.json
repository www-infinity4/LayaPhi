{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layaphi/tool-candidate.schema.json",
  "title": "ToolScanner candidate metadata (input, discovery only)",
  "type": "object",
  "required": ["repository", "purpose", "license", "lastPushed", "framework", "dependencies", "bundleKb", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "purpose": { "type": "string" },
    "category": { "type": "string" },
    "license": { "type": "string" },
    "lastPushed": { "type": "string", "description": "ISO date" },
    "stars": { "type": "integer", "minimum": 0 },
    "archived": { "type": "boolean" },
    "framework": { "type": "string" },
    "dependencies": { "type": "integer", "minimum": 0 },
    "bundleKb": { "type": "number", "minimum": 0 },
    "installScripts": { "type": "boolean" },
    "nativeBinaries": { "type": "boolean" },
    "networkAtRuntime": { "type": "boolean" },
    "knownAdvisories": { "type": "integer", "minimum": 0 },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
