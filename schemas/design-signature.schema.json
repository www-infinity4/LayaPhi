{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layaphi/design-signature.schema.json",
  "title": "LayaPhi Design Signature",
  "type": "object",
  "required": ["id", "name", "description", "typography", "spacing", "contentWidth", "colors", "contrast", "borders", "corners", "shadows", "rhythm", "hero", "imageTreatment", "videoTreatment", "navigation", "cards", "modeTreatment", "animation", "breakpoints", "suits", "mutation"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "typography": {
      "type": "object",
      "required": ["baseSize", "scaleRatio", "lineHeight", "fontRoles", "weights"],
      "additionalProperties": false,
      "properties": {
        "baseSize": { "type": "number", "minimum": 1, "maximum": 1.5, "description": "rem" },
        "scaleRatio": { "type": "number", "minimum": 1.1, "maximum": 1.6 },
        "lineHeight": { "type": "number", "minimum": 1.3, "maximum": 2 },
        "fontRoles": {
          "type": "object",
          "required": ["heading", "body", "mono"],
          "additionalProperties": false,
          "properties": { "heading": { "type": "string" }, "body": { "type": "string" }, "mono": { "type": "string" } }
        },
        "weights": {
          "type": "object",
          "required": ["body", "heading", "strong"],
          "additionalProperties": false,
          "properties": {
            "body": { "type": "integer", "minimum": 100, "maximum": 900 },
            "heading": { "type": "integer", "minimum": 100, "maximum": 900 },
            "strong": { "type": "integer", "minimum": 100, "maximum": 900 }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["unit", "scale"],
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "number", "minimum": 0.25, "maximum": 1, "description": "rem" },
        "scale": { "type": "array", "minItems": 5, "items": { "type": "number", "minimum": 0 } }
      }
    },
    "contentWidth": {
      "type": "object",
      "required": ["text", "page"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "integer", "minimum": 30, "maximum": 100, "description": "ch" },
        "page": { "type": "integer", "minimum": 640, "maximum": 1800, "description": "px" }
      }
    },
    "colors": {
      "type": "object",
      "required": ["scheme", "bg", "surface", "text", "muted", "link", "accent", "focus", "border", "modes"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "type": "string", "enum": ["light", "dark"] },
        "bg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "muted": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "link": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "focus": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "border": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "modes": {
          "type": "object",
          "required": ["yellow", "green", "blue", "red", "orange"],
          "additionalProperties": false,
          "properties": {
            "yellow": { "$ref": "#/definitions/modeColor" },
            "green": { "$ref": "#/definitions/modeColor" },
            "blue": { "$ref": "#/definitions/modeColor" },
            "red": { "$ref": "#/definitions/modeColor" },
            "orange": { "$ref": "#/definitions/modeColor" }
          }
        }
      }
    },
    "contrast": {
      "type": "object",
      "required": ["text", "nonText"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "number", "minimum": 4.5, "description": "WCAG AA normal text minimum" },
        "nonText": { "type": "number", "minimum": 3, "description": "WCAG AA UI components minimum" }
      }
    },
    "borders": {
      "type": "object",
      "required": ["width", "style"],
      "additionalProperties": false,
      "properties": { "width": { "type": "number", "minimum": 0, "maximum": 8 }, "style": { "type": "string", "enum": ["solid", "dashed", "double"] } }
    },
    "corners": {
      "type": "object",
      "required": ["radius", "geometry"],
      "additionalProperties": false,
      "properties": { "radius": { "type": "number", "minimum": 0, "maximum": 48, "description": "px" }, "geometry": { "type": "string", "enum": ["square", "soft", "round", "pill"] } }
    },
    "shadows": {
      "type": "object",
      "required": ["card"],
      "additionalProperties": false,
      "properties": { "card": { "type": "string" } }
    },
    "rhythm": {
      "type": "object",
      "required": ["section", "pattern"],
      "additionalProperties": false,
      "properties": {
        "section": { "type": "integer", "minimum": 0, "maximum": 8, "description": "index into spacing.scale" },
        "pattern": { "type": "string", "enum": ["uniform", "alternating", "accelerating"] }
      }
    },
    "hero": {
      "type": "object",
      "required": ["behavior", "minHeight"],
      "additionalProperties": false,
      "properties": {
        "behavior": { "type": "string", "enum": ["full", "split", "stacked", "typographic"] },
        "minHeight": { "type": "integer", "minimum": 0, "maximum": 80, "description": "svh, 0 = content height" }
      }
    },
    "imageTreatment": {
      "type": "object",
      "required": ["aspect", "fit", "frame"],
      "additionalProperties": false,
      "properties": {
        "aspect": { "type": "string", "pattern": "^[0-9]+ / [0-9]+$" },
        "fit": { "type": "string", "enum": ["cover", "contain"] },
        "frame": { "type": "string", "enum": ["none", "border", "shadow", "matte"] }
      }
    },
    "videoTreatment": {
      "type": "object",
      "required": ["aspect", "frame", "chapterStyle"],
      "additionalProperties": false,
      "properties": {
        "aspect": { "type": "string", "pattern": "^[0-9]+ / [0-9]+$" },
        "frame": { "type": "string", "enum": ["none", "border", "shadow", "matte"] },
        "chapterStyle": { "type": "string", "enum": ["list", "chips"] }
      }
    },
    "navigation": {
      "type": "object",
      "required": ["default", "allowed", "stickyHeader"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "enum": ["top-bar", "bottom-bar", "sticky-toc", "minimal"] },
        "allowed": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["top-bar", "bottom-bar", "sticky-toc", "minimal"] } },
        "stickyHeader": { "type": "boolean" }
      }
    },
    "cards": {
      "type": "object",
      "required": ["style", "padding"],
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string", "enum": ["plain", "outlined", "raised", "filled"] },
        "padding": { "type": "number", "minimum": 0.5, "maximum": 3, "description": "rem" }
      }
    },
    "modeTreatment": { "type": "string", "enum": ["tint", "stripe", "badge", "solid", "outline"], "description": "How the five Phi educational modes are visually realised" },
    "animation": {
      "type": "object",
      "required": ["maxDurationMs", "transitions"],
      "additionalProperties": false,
      "properties": {
        "maxDurationMs": { "type": "integer", "minimum": 0, "maximum": 500 },
        "transitions": { "type": "boolean" }
      }
    },
    "breakpoints": {
      "type": "object",
      "required": ["md", "lg"],
      "additionalProperties": false,
      "properties": { "md": { "type": "integer", "minimum": 480, "maximum": 900, "description": "px" }, "lg": { "type": "integer", "minimum": 800, "maximum": 1400, "description": "px" } }
    },
    "suits": {
      "type": "object",
      "required": ["profiles", "archetypes"],
      "additionalProperties": false,
      "properties": {
        "profiles": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["reader", "visual", "video", "mixed"] } },
        "archetypes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "mutation": {
      "type": "object",
      "required": ["allowed"],
      "additionalProperties": false,
      "properties": { "allowed": { "type": "array", "items": { "type": "string" } } }
    }
  },
  "definitions": {
    "modeColor": {
      "type": "object",
      "required": ["bg", "fg", "accent"],
      "additionalProperties": false,
      "properties": {
        "bg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "fg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    }
  }
}
