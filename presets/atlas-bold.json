{
  "id": "atlas-bold",
  "name": "Atlas Bold",
  "description": "Large confident sans-serif type, full-bleed hero and solid mode blocks; visual storytelling.",
  "typography": {
    "baseSize": 1.0625,
    "scaleRatio": 1.333,
    "lineHeight": 1.55,
    "fontRoles": {
      "heading": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weights": {
      "body": 400,
      "heading": 800,
      "strong": 700
    }
  },
  "spacing": {
    "unit": 0.5,
    "scale": [
      0.25,
      0.5,
      1,
      1.5,
      2,
      3,
      4.5,
      6
    ]
  },
  "contentWidth": {
    "text": 66,
    "page": 1120
  },
  "colors": {
    "scheme": "light",
    "bg": "#ffffff",
    "surface": "#eef1f6",
    "text": "#10141a",
    "muted": "#444c58",
    "link": "#0a4fc4",
    "accent": "#0a4fc4",
    "focus": "#0a4fc4",
    "border": "#9aa3b0",
    "modes": {
      "yellow": {
        "bg": "#fff6cc",
        "fg": "#4a3b00",
        "accent": "#8a6a00"
      },
      "green": {
        "bg": "#e3f5e8",
        "fg": "#0b3d1c",
        "accent": "#1b7f3b"
      },
      "blue": {
        "bg": "#e1edfb",
        "fg": "#0d2c54",
        "accent": "#1f5fbf"
      },
      "red": {
        "bg": "#fde4e1",
        "fg": "#5a0f0a",
        "accent": "#c0392b"
      },
      "orange": {
        "bg": "#ffe9d6",
        "fg": "#5a2a00",
        "accent": "#b45309"
      }
    }
  },
  "contrast": {
    "text": 4.5,
    "nonText": 3
  },
  "borders": {
    "width": 1,
    "style": "solid"
  },
  "corners": {
    "radius": 14,
    "geometry": "round"
  },
  "shadows": {
    "card": "0 6px 18px rgba(16,20,26,.14)"
  },
  "rhythm": {
    "section": 5,
    "pattern": "uniform"
  },
  "hero": {
    "behavior": "full",
    "minHeight": 60
  },
  "imageTreatment": {
    "aspect": "3 / 2",
    "fit": "cover",
    "frame": "shadow"
  },
  "videoTreatment": {
    "aspect": "16 / 9",
    "frame": "none",
    "chapterStyle": "list"
  },
  "navigation": {
    "default": "top-bar",
    "allowed": [
      "top-bar",
      "bottom-bar",
      "minimal"
    ],
    "stickyHeader": true
  },
  "cards": {
    "style": "raised",
    "padding": 1.5
  },
  "modeTreatment": "solid",
  "animation": {
    "maxDurationMs": 200,
    "transitions": true
  },
  "breakpoints": {
    "md": 640,
    "lg": 1024
  },
  "suits": {
    "profiles": [
      "visual",
      "mixed",
      "video"
    ],
    "archetypes": [
      "explainer",
      "visual-story",
      "landing",
      "course"
    ]
  },
  "mutation": {
    "allowed": [
      "hero.orientation",
      "section.order",
      "column.ratio",
      "media.placement",
      "density",
      "navigation.style",
      "section.rhythm",
      "type.scale",
      "card.geometry",
      "whitespace",
      "source.presentation"
    ]
  }
}
