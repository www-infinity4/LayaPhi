{
  "id": "gallery-white",
  "name": "Gallery White",
  "description": "Gallery-like minimalism: abundant whitespace, matted imagery, quiet badges for modes.",
  "typography": {
    "baseSize": 1.0625,
    "scaleRatio": 1.25,
    "lineHeight": 1.7,
    "fontRoles": {
      "heading": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weights": {
      "body": 300,
      "heading": 300,
      "strong": 600
    }
  },
  "spacing": {
    "unit": 0.5,
    "scale": [
      0.25,
      0.5,
      1,
      1.5,
      2,
      3,
      4.5,
      6
    ]
  },
  "contentWidth": {
    "text": 66,
    "page": 1120
  },
  "colors": {
    "scheme": "light",
    "bg": "#ffffff",
    "surface": "#f6f6f6",
    "text": "#161616",
    "muted": "#4a4a4a",
    "link": "#1a1a1a",
    "accent": "#1a1a1a",
    "focus": "#0b57d0",
    "border": "#a8a8a8",
    "modes": {
      "yellow": {
        "bg": "#fff6cc",
        "fg": "#4a3b00",
        "accent": "#8a6a00"
      },
      "green": {
        "bg": "#e3f5e8",
        "fg": "#0b3d1c",
        "accent": "#1b7f3b"
      },
      "blue": {
        "bg": "#e1edfb",
        "fg": "#0d2c54",
        "accent": "#1f5fbf"
      },
      "red": {
        "bg": "#fde4e1",
        "fg": "#5a0f0a",
        "accent": "#c0392b"
      },
      "orange": {
        "bg": "#ffe9d6",
        "fg": "#5a2a00",
        "accent": "#b45309"
      }
    }
  },
  "contrast": {
    "text": 4.5,
    "nonText": 3
  },
  "borders": {
    "width": 1,
    "style": "solid"
  },
  "corners": {
    "radius": 0,
    "geometry": "square"
  },
  "shadows": {
    "card": "none"
  },
  "rhythm": {
    "section": 6,
    "pattern": "accelerating"
  },
  "hero": {
    "behavior": "stacked",
    "minHeight": 0
  },
  "imageTreatment": {
    "aspect": "4 / 3",
    "fit": "contain",
    "frame": "matte"
  },
  "videoTreatment": {
    "aspect": "16 / 9",
    "frame": "none",
    "chapterStyle": "list"
  },
  "navigation": {
    "default": "minimal",
    "allowed": [
      "minimal",
      "top-bar",
      "bottom-bar"
    ],
    "stickyHeader": false
  },
  "cards": {
    "style": "plain",
    "padding": 1
  },
  "modeTreatment": "badge",
  "animation": {
    "maxDurationMs": 300,
    "transitions": true
  },
  "breakpoints": {
    "md": 640,
    "lg": 1024
  },
  "suits": {
    "profiles": [
      "visual",
      "mixed"
    ],
    "archetypes": [
      "visual-story",
      "explainer",
      "landing"
    ]
  },
  "mutation": {
    "allowed": [
      "hero.orientation",
      "section.order",
      "column.ratio",
      "media.placement",
      "density",
      "navigation.style",
      "section.rhythm",
      "type.scale",
      "card.geometry",
      "whitespace",
      "source.presentation"
    ]
  }
}
