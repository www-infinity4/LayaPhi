{
  "id": "terra-museum",
  "name": "Terra Museum",
  "description": "Earthy museum-label look: serif display, split heroes, framed imagery and soft stripes.",
  "typography": {
    "baseSize": 1.0625,
    "scaleRatio": 1.25,
    "lineHeight": 1.6,
    "fontRoles": {
      "heading": "Georgia, 'Iowan Old Style', 'Times New Roman', serif",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weights": {
      "body": 400,
      "heading": 600,
      "strong": 700
    }
  },
  "spacing": {
    "unit": 0.5,
    "scale": [
      0.25,
      0.5,
      1,
      1.5,
      2,
      3,
      4.5,
      6
    ]
  },
  "contentWidth": {
    "text": 66,
    "page": 1120
  },
  "colors": {
    "scheme": "light",
    "bg": "#f4efe6",
    "surface": "#e8dfcf",
    "text": "#2b241c",
    "muted": "#5a4e3f",
    "link": "#7c3a12",
    "accent": "#7c3a12",
    "focus": "#7c3a12",
    "border": "#a8967a",
    "modes": {
      "yellow": {
        "bg": "#fff6cc",
        "fg": "#4a3b00",
        "accent": "#8a6a00"
      },
      "green": {
        "bg": "#e3f5e8",
        "fg": "#0b3d1c",
        "accent": "#1b7f3b"
      },
      "blue": {
        "bg": "#e1edfb",
        "fg": "#0d2c54",
        "accent": "#1f5fbf"
      },
      "red": {
        "bg": "#fde4e1",
        "fg": "#5a0f0a",
        "accent": "#c0392b"
      },
      "orange": {
        "bg": "#ffe9d6",
        "fg": "#5a2a00",
        "accent": "#b45309"
      }
    }
  },
  "contrast": {
    "text": 4.5,
    "nonText": 3
  },
  "borders": {
    "width": 2,
    "style": "double"
  },
  "corners": {
    "radius": 4,
    "geometry": "soft"
  },
  "shadows": {
    "card": "none"
  },
  "rhythm": {
    "section": 6,
    "pattern": "alternating"
  },
  "hero": {
    "behavior": "split",
    "minHeight": 40
  },
  "imageTreatment": {
    "aspect": "4 / 3",
    "fit": "cover",
    "frame": "border"
  },
  "videoTreatment": {
    "aspect": "16 / 9",
    "frame": "none",
    "chapterStyle": "list"
  },
  "navigation": {
    "default": "top-bar",
    "allowed": [
      "top-bar",
      "sticky-toc",
      "minimal"
    ],
    "stickyHeader": false
  },
  "cards": {
    "style": "outlined",
    "padding": 1.25
  },
  "modeTreatment": "stripe",
  "animation": {
    "maxDurationMs": 200,
    "transitions": true
  },
  "breakpoints": {
    "md": 640,
    "lg": 1024
  },
  "suits": {
    "profiles": [
      "visual",
      "mixed",
      "reader"
    ],
    "archetypes": [
      "explainer",
      "visual-story",
      "article",
      "course"
    ]
  },
  "mutation": {
    "allowed": [
      "hero.orientation",
      "section.order",
      "column.ratio",
      "media.placement",
      "density",
      "navigation.style",
      "section.rhythm",
      "type.scale",
      "card.geometry",
      "whitespace",
      "source.presentation"
    ]
  }
}
