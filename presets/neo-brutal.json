{
  "id": "neo-brutal",
  "name": "Neo Brutal",
  "description": "Thick black borders, hard offset shadows and flat saturated mode blocks; loud and tactile.",
  "typography": {
    "baseSize": 1.0625,
    "scaleRatio": 1.333,
    "lineHeight": 1.6,
    "fontRoles": {
      "heading": "'Arial Black', Impact, sans-serif",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weights": {
      "body": 500,
      "heading": 900,
      "strong": 800
    }
  },
  "spacing": {
    "unit": 0.5,
    "scale": [
      0.25,
      0.5,
      1,
      1.5,
      2,
      3,
      4.5,
      6
    ]
  },
  "contentWidth": {
    "text": 66,
    "page": 1120
  },
  "colors": {
    "scheme": "light",
    "bg": "#fffdf5",
    "surface": "#ffffff",
    "text": "#000000",
    "muted": "#2b2b2b",
    "link": "#0000cc",
    "accent": "#000000",
    "focus": "#d10000",
    "border": "#000000",
    "modes": {
      "yellow": {
        "bg": "#fff6cc",
        "fg": "#4a3b00",
        "accent": "#8a6a00"
      },
      "green": {
        "bg": "#e3f5e8",
        "fg": "#0b3d1c",
        "accent": "#1b7f3b"
      },
      "blue": {
        "bg": "#e1edfb",
        "fg": "#0d2c54",
        "accent": "#1f5fbf"
      },
      "red": {
        "bg": "#fde4e1",
        "fg": "#5a0f0a",
        "accent": "#c0392b"
      },
      "orange": {
        "bg": "#ffe9d6",
        "fg": "#5a2a00",
        "accent": "#b45309"
      }
    }
  },
  "contrast": {
    "text": 4.5,
    "nonText": 3
  },
  "borders": {
    "width": 3,
    "style": "solid"
  },
  "corners": {
    "radius": 0,
    "geometry": "square"
  },
  "shadows": {
    "card": "6px 6px 0 #000000"
  },
  "rhythm": {
    "section": 5,
    "pattern": "uniform"
  },
  "hero": {
    "behavior": "stacked",
    "minHeight": 0
  },
  "imageTreatment": {
    "aspect": "16 / 9",
    "fit": "cover",
    "frame": "none"
  },
  "videoTreatment": {
    "aspect": "16 / 9",
    "frame": "none",
    "chapterStyle": "list"
  },
  "navigation": {
    "default": "bottom-bar",
    "allowed": [
      "bottom-bar",
      "top-bar"
    ],
    "stickyHeader": true
  },
  "cards": {
    "style": "raised",
    "padding": 1.25
  },
  "modeTreatment": "solid",
  "animation": {
    "maxDurationMs": 120,
    "transitions": true
  },
  "breakpoints": {
    "md": 640,
    "lg": 1024
  },
  "suits": {
    "profiles": [
      "visual",
      "mixed",
      "video"
    ],
    "archetypes": [
      "landing",
      "visual-story",
      "project-guide",
      "explainer"
    ]
  },
  "mutation": {
    "allowed": [
      "hero.orientation",
      "section.order",
      "column.ratio",
      "media.placement",
      "density",
      "navigation.style",
      "section.rhythm",
      "type.scale",
      "card.geometry",
      "whitespace",
      "source.presentation"
    ]
  }
}
