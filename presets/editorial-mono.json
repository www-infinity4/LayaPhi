{
  "id": "editorial-mono",
  "name": "Editorial Mono",
  "description": "High-contrast monochrome editorial: typographic hero, hairlines, outlined mode labels.",
  "typography": {
    "baseSize": 1.0625,
    "scaleRatio": 1.333,
    "lineHeight": 1.6,
    "fontRoles": {
      "heading": "Georgia, 'Iowan Old Style', 'Times New Roman', serif",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weights": {
      "body": 400,
      "heading": 800,
      "strong": 700
    }
  },
  "spacing": {
    "unit": 0.5,
    "scale": [
      0.25,
      0.5,
      1,
      1.5,
      2,
      3,
      4.5,
      6
    ]
  },
  "contentWidth": {
    "text": 68,
    "page": 1200
  },
  "colors": {
    "scheme": "light",
    "bg": "#ffffff",
    "surface": "#f2f2f2",
    "text": "#000000",
    "muted": "#3d3d3d",
    "link": "#000000",
    "accent": "#000000",
    "focus": "#0b57d0",
    "border": "#6b6b6b",
    "modes": {
      "yellow": {
        "bg": "#fff6cc",
        "fg": "#4a3b00",
        "accent": "#8a6a00"
      },
      "green": {
        "bg": "#e3f5e8",
        "fg": "#0b3d1c",
        "accent": "#1b7f3b"
      },
      "blue": {
        "bg": "#e1edfb",
        "fg": "#0d2c54",
        "accent": "#1f5fbf"
      },
      "red": {
        "bg": "#fde4e1",
        "fg": "#5a0f0a",
        "accent": "#c0392b"
      },
      "orange": {
        "bg": "#ffe9d6",
        "fg": "#5a2a00",
        "accent": "#b45309"
      }
    }
  },
  "contrast": {
    "text": 4.5,
    "nonText": 3
  },
  "borders": {
    "width": 1,
    "style": "solid"
  },
  "corners": {
    "radius": 0,
    "geometry": "square"
  },
  "shadows": {
    "card": "none"
  },
  "rhythm": {
    "section": 5,
    "pattern": "uniform"
  },
  "hero": {
    "behavior": "typographic",
    "minHeight": 0
  },
  "imageTreatment": {
    "aspect": "16 / 9",
    "fit": "cover",
    "frame": "none"
  },
  "videoTreatment": {
    "aspect": "16 / 9",
    "frame": "none",
    "chapterStyle": "list"
  },
  "navigation": {
    "default": "top-bar",
    "allowed": [
      "top-bar",
      "sticky-toc",
      "minimal"
    ],
    "stickyHeader": false
  },
  "cards": {
    "style": "plain",
    "padding": 1
  },
  "modeTreatment": "outline",
  "animation": {
    "maxDurationMs": 200,
    "transitions": true
  },
  "breakpoints": {
    "md": 640,
    "lg": 1024
  },
  "suits": {
    "profiles": [
      "reader",
      "mixed"
    ],
    "archetypes": [
      "article",
      "explainer",
      "research"
    ]
  },
  "mutation": {
    "allowed": [
      "hero.orientation",
      "section.order",
      "column.ratio",
      "media.placement",
      "density",
      "navigation.style",
      "section.rhythm",
      "type.scale",
      "card.geometry",
      "whitespace",
      "source.presentation"
    ]
  }
}
